# All managed repos live in workbench/ (each subfolder is its own git repo)
/workbench/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]


# Git flag store, its hash-chained change log, lock and temp files — per workspace, never committed
.codex/git-flags.*
.codex/.git-flags-*

# Stray local output: app smoke logs written to the workspace root and a local pnpm store
/logs/
/.pnpm-store/
