{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wow-two/deploy.schema.json",
  "title": "wow-two deployment descriptor (engineering/deployment/deploy.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor", "product", "services"],
  "properties": {
    "descriptor": { "enum": [1, 2], "description": "Format version: 2; 1 is deprecated (one path per service site, no top-level sites)." },
    "product": { "$ref": "#/$defs/slug", "description": "The Wheelhouse runner product slug." },
    "name": { "$ref": "#/$defs/name", "description": "Identity: the product's display name, declared with description. Pipelines v0.11.0 or later." },
    "description": { "$ref": "#/$defs/description", "description": "Identity: one line on what the product does, declared with name." },
    "homepage": {
      "type": "string", "maxLength": 300,
      "pattern": "^https?://[^\\s@/?#]+(?:[/?#]\\S*)?$",
      "description": "Identity: the product's public address; no credentials in it."
    },
    "platform": { "enum": ["linux/amd64", "linux/arm64"], "default": "linux/amd64" },
    "shared": {
      "type": "array", "items": { "$ref": "#/$defs/path" },
      "description": "Paths, relative to engineering/, whose change rebuilds every service."
    },
    "sites": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/slug" },
      "description": "Descriptor 2: the product's sites, host roles Wheelhouse binds to one host per environment. Hosts, zones and proxy settings never appear here.",
      "additionalProperties": {
        "type": ["object", "null"], "additionalProperties": false,
        "properties": {
          "exposure": { "enum": ["public", "private"], "default": "public" },
          "primary": { "type": "boolean", "description": "The front door; at most one site. Default: the first site." },
          "environments": {
            "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["dev", "prod"] },
            "default": ["dev", "prod"], "description": "The environments that publish the site."
          }
        }
      }
    },
    "services": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "dotnetEnvironment": {
      "type": "boolean", "default": false,
      "description": "Run dev as .NET Development and prod as Production: the runner sets ASPNETCORE_ENVIRONMENT and DOTNET_ENVIRONMENT. Only when appsettings.Development.json holds no machine-local value."
    },
    "verify": {
      "type": "object", "additionalProperties": false, "required": ["service", "command"],
      "description": "The end-to-end check the runner runs after a dev rollout succeeds; auto-promote takes only a release whose check passed.",
      "properties": {
        "service": { "$ref": "#/$defs/slug", "description": "The service whose release image runs the check." },
        "command": {
          "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "description": "The program and its arguments; replaces the image's entrypoint."
        },
        "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$", "default": "5m", "description": "10s-30m." }
      }
    },
    "migrate": {
      "type": "array", "minItems": 1,
      "description": "The migrate step: one item per image that hosts a migration set, run after the pull and before the first wave on every forward deploy. Pipelines v0.12.0 or later.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["service", "command"],
        "properties": {
          "service": { "$ref": "#/$defs/slug", "description": "A service of this descriptor whose release image hosts the sets." },
          "command": {
            "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "description": "The program and its arguments, ending in the bare migrate verb; replaces the image's entrypoint."
          },
          "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$", "default": "10m", "description": "10s-60m." }
        }
      }
    },
    "extensions": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
      "description": "Untrusted PostgreSQL extensions Wheelhouse creates as superuser when it places the product's database; a set creates trusted ones itself. Pipelines v0.12.0 or later."
    }
  },
  "dependentRequired": { "name": ["description"], "description": ["name"], "homepage": ["name", "description"] },
  "if": { "properties": { "descriptor": { "const": 1 } } },
  "then": {
    "properties": {
      "sites": false,
      "services": { "additionalProperties": { "properties": { "sites": { "$ref": "#/$defs/sitesV1" } } } }
    }
  },
  "else": {
    "properties": {
      "services": { "additionalProperties": { "properties": { "sites": { "$ref": "#/$defs/sitesV2" } } } }
    }
  },
  "$defs": {
    "settingKey": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "type": { "enum": ["text", "number", "boolean", "choice", "url", "cron", "date", "email"], "default": "text" },
        "required": { "type": "boolean", "default": false },
        "secret": { "type": "boolean", "default": false },
        "default": { "type": ["string", "number", "boolean"], "description": "An optional plain key's default, checked against its type." },
        "values": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": ["string", "number", "boolean"] }, "description": "A choice's values." },
        "format": { "type": "string", "pattern": "^(yyyy|MM|dd|HH|mm|ss|[-./: T])+$", "default": "yyyy-MM-dd", "description": "A date's format." }
      }
    },
    "sitePath": {
      "type": "string", "maxLength": 200, "pattern": "^(/|(/[A-Za-z0-9._~-]+)+)$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" },
      "description": "/ or /a/b: no trailing slash, no . or .. segment. /api serves /api and /api/…, never /apiary."
    },
    "sitesV2": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/slug" },
      "description": "Site name (declared under the top-level sites) → the paths this service serves there. One service per site path.",
      "additionalProperties": {
        "type": ["object", "null"], "additionalProperties": false,
        "properties": {
          "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sitePath" }, "default": ["/"] },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Default: the service port." }
        }
      }
    },
    "sitesV1": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/slug" },
      "description": "Deprecated descriptor 1: site name → port, one path prefix and exposure.",
      "additionalProperties": {
        "type": ["object", "null"], "additionalProperties": false,
        "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "path": { "type": "string", "pattern": "^/" },
          "exposure": { "enum": ["public", "private"], "default": "public" }
        }
      }
    },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "name": {
      "type": "string", "minLength": 1, "maxLength": 80,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
    },
    "description": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
    },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "^/|(^|/)\\.\\.(/|$)" } },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health"],
      "if": { "required": ["build"] },
      "then": {
        "required": ["paths"],
        "properties": { "image": { "not": { "pattern": ":[^/]*$" } } }
      },
      "else": {
        "required": ["image"],
        "properties": {
          "image": {
            "pattern": ":[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$", "not": { "pattern": ":latest$" },
            "description": "A pinned image: another repository's published image with its release tag, never latest. Pipelines v0.12.0 or later."
          },
          "paths": false
        }
      },
      "properties": {
        "name": { "$ref": "#/$defs/name", "description": "Identity: the service's display name. Pipelines v0.11.0 or later." },
        "description": { "$ref": "#/$defs/description", "description": "Identity: one line on what the service does." },
        "image": {
          "type": "string", "pattern": "^[a-z0-9][a-z0-9._/:-]*[a-z0-9](:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$",
          "description": "With build: the image repository without a tag, for a legacy name (default <registry>/<service>). Without build: a pinned image with its tag."
        },
        "build": {
          "type": "object", "additionalProperties": false, "required": ["dockerfile"],
          "properties": {
            "dockerfile": { "$ref": "#/$defs/path" },
            "context": { "$ref": "#/$defs/path", "default": "codebase" },
            "target": { "type": "string" },
            "args": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
            "contexts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/path" } }
          }
        },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8080 },
        "health": {
          "oneOf": [
            { "type": "string", "pattern": "^/" },
            {
              "type": "object", "additionalProperties": false, "required": ["command"],
              "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
            }
          ]
        },
        "memory": { "type": "string", "pattern": "^[1-9][0-9]*[kmg]$", "default": "512m" },
        "stopGrace": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$", "default": "30s" },
        "settings": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "pattern": "^/", "default": "/app/appsettings.Target.json" },
            "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "keys": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,100}(:[A-Za-z0-9_.-]{1,100}){0,9}$" },
              "additionalProperties": { "$ref": "#/$defs/settingKey" },
              "description": "Typed setting keys: type, required or secret, a default for an optional plain key, a choice's values, a date's format. Required keys join required. Pipelines v0.10.0 or later."
            }
          }
        },
        "volumes": {
          "type": "object", "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": { "type": "string", "pattern": "^/" }
        },
        "sites": { "type": "object", "propertyNames": { "$ref": "#/$defs/slug" } },
        "needs": { "type": "array", "items": { "enum": ["postgres", "valkey", "broker"] } },
        "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z_]{1,31}$" } },
        "dependsOn": {
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" },
          "description": "Services of this product the service starts after, once each is healthy; never itself, never a cycle. Backing services (postgres, valkey, broker) go under needs. Pipelines v0.6.0 or later."
        }
      }
    }
  }
}
